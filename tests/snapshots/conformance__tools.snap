  {
    "description": "Says the text back, with the project it was said in.",
    "feature": "shout",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "text": {
          "description": "What to say.",
          "type": "string"
        }
      },

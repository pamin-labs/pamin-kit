---
source: tests/conformance.rs
expression: tools
---
{
  "prompts": [
    {
      "arguments": [
        {
          "description": "Who to greet.",
          "name": "name",
          "required": true
        }
      ],
      "description": "Starts a conversation about something to say.",
      "feature": "core",
      "name": "echo_greet"
    }
  ],
  "resources": [
    {
      "description": null,
      "feature": "core",
      "name": "About echo",
      "uri": "echo://about"
    },
    {
      "description": "Text to say, as a resource: what reading it would say back.",
      "feature": "core",
      "name": "Said",
      "uri": "echo://say/{text}"
    }
  ],
  "tools": [
    {
      "description": "Says the text back, with the project it was said in.",
      "feature": "core",
      "hints": {
        "destructive": true,
        "idempotent": true,
        "open_world": false,
        "read_only": true,
        "title": "Say"
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "description": "What to say.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "name": "echo_say",
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "project"
        ],
        "type": "object"
      },
      "task": false,
      "ui": "ui://echo/said"
    },
    {
      "description": "Says the text back, with the project it was said in.",
      "feature": "shout",
      "hints": null,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "description": "What to say.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "name": "echo_shout",
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "project"
        ],
        "type": "object"
      },
      "task": false,
      "ui": null
    },
    {
      "description": "Asks the user before saying the text back.",
      "feature": "core",
      "hints": null,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "description": "What to say, once the user agrees.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "name": "echo_confirm",
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "project"
        ],
        "type": "object"
      },
      "task": false,
      "ui": null
    },
    {
      "description": "Waits, then says the text back.",
      "feature": "core",
      "hints": null,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "millis": {
            "description": "How long to wait first, in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "description": "What to say.",
            "type": "string"
          }
        },
        "required": [
          "text",
          "millis"
        ],
        "type": "object"
      },
      "name": "echo_wait",
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "project"
        ],
        "type": "object"
      },
      "task": true,
      "ui": null
    }
  ]
}
